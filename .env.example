# ── Database ──────────────────────────────────────────
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=sportcard
DATABASE_PASSWORD=sportcard_dev
DATABASE_NAME=sportcard

# ── Google OAuth ──────────────────────────────────────
# Obtén estas credenciales en: https://console.cloud.google.com
# Authorized redirect URIs: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ── JWT ───────────────────────────────────────────────
JWT_SECRET=cambiar-por-un-secreto-seguro-minimo-32-chars
JWT_EXPIRES_IN=7d

# ── App ───────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost:4200
NODE_ENV=development

# ── Dev Auth (feature flag) ───────────────────────────
# Activa un login con usuario/clave para omitir Google OAuth en desarrollo.
# Bloqueado automáticamente cuando NODE_ENV=production.
DEV_AUTH_ENABLED=true
DEV_AUTH_EMAIL=dev@sportcard.dev
DEV_AUTH_PASSWORD=dev1234
DEV_AUTH_NAME=Dev User
